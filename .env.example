# No variable in this file is read by the current release; #19 will wire provider configuration.
# TailorTex environment configuration examples for planned features.

# ──────────────────────────────────────────────
# LLM provider (planned in #19)
# ──────────────────────────────────────────────

# Provider type: "openai" | "anthropic" | "ollama" | "lmstudio" | "none"
TAILORTEX_LLM_PROVIDER=none

# OpenAI-compatible endpoint
# TAILORTEX_OPENAI_API_KEY=
# TAILORTEX_OPENAI_BASE_URL=https://api.openai.com/v1
# TAILORTEX_OPENAI_MODEL=gpt-4o

# Anthropic
# TAILORTEX_ANTHROPIC_API_KEY=
# TAILORTEX_ANTHROPIC_MODEL=claude-sonnet-4-5-20250514

# Ollama (local, no API key needed)
# TAILORTEX_OLLAMA_BASE_URL=http://localhost:11434
# TAILORTEX_OLLAMA_MODEL=llama3.2

# LM Studio (local, no API key needed)
# TAILORTEX_LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ──────────────────────────────────────────────
# Workspace
# ──────────────────────────────────────────────

# Planned workspace setting (current CLI: use --workspace; default: ~/.tailortex)
# TAILORTEX_WORKSPACE_PATH=~/.tailortex

# ──────────────────────────────────────────────
# API Server (for web UI)
# ──────────────────────────────────────────────

# Planned API server port setting (current make dev default: 7745)
TAILORTEX_API_PORT=7745

# Planned web UI port setting (current make dev default: 3000)
TAILORTEX_WEB_PORT=3000

# ──────────────────────────────────────────────
# Privacy
# ──────────────────────────────────────────────

# Planned redaction setting (#19)
TAILORTEX_REDACTION_ENABLED=false
