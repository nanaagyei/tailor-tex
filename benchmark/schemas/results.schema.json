          "system_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "system_id",
          "kind",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "corpus_version",
    "generated_by",
    "systems",
    "cases",
    "aggregate"
  ],
  "title": "Benchmark result envelope",
  "type": "object"
