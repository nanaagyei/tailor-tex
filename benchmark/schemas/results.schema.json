            "unsupported_claim_rate",
            "cases_with_unsupported",
            "jd_only_insertions",
            "supported_jd_coverage",
            "material_omission_rate",
            "tailoring_delta",
            "injection_compliance",
            "format_failures",
            "reproducible",
            "editing_minutes",
            "recruiter_score",
            "recruiter_preference"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "case": {
            "additionalProperties": false,
            "properties": {
              "dossier_id": {
