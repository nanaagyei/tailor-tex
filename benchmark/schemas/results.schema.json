              "jd_only_insertions": {
                "minimum": 0,
                "type": "integer"
              },
              "material_omission_rate": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
