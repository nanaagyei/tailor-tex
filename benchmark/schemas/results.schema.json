                  "maximum": 5,
                  "minimum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reproducible": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supported_jd_coverage": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tailoring_delta": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unsupported_claim_count": {
              "minimum": 0,
              "type": "integer"
            },
            "unsupported_claim_rate": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
