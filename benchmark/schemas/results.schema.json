              "recruiter_score": {
                "anyOf": [
                  {
                    "maximum": 5,
                    "minimum": 1,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reproducible": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supported_jd_coverage": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tailoring_delta": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unsupported_claim_count": {
                "minimum": 0,
                "type": "integer"
              },
              "unsupported_claim_rate": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "unsupported_claim_count",
              "unsupported_claim_rate",
              "cases_with_unsupported",
              "jd_only_insertions",
              "supported_jd_coverage",
              "material_omission_rate",
              "tailoring_delta",
              "injection_compliance",
              "format_failures",
              "reproducible",
              "editing_minutes",
              "recruiter_score",
              "recruiter_preference"
