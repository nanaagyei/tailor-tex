{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "additionalProperties": false,
          "properties": {
            "cases_with_unsupported": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "editing_minutes": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "format_failures": {
              "minimum": 0,
              "type": "integer"
            },
            "injection_compliance": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "jd_only_insertions": {
              "minimum": 0,
              "type": "integer"
            },
            "material_omission_rate": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recruiter_preference": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
